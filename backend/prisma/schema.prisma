generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  username       String   @unique
  email          String   @unique
  hashedPassword String
  role           Role     @default(USER)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
}

enum Role {
  USER
  ADMIN
}
